# ─── Local Bridge configuration ─────────────────────────────────────────────

# Cloud dashboard / relay URL (the deployed dashboard). Use wss:// in production.
# Examples:
#   https://your-app.up.railway.app
#   https://ai-trading-dashboard.onrender.com
CLOUD_URL=http://localhost:3000

# Connection token. Leave blank to auto-generate one on first run (it is then
# saved to .bridge-token). Paste this same token into the dashboard to pair.
BRIDGE_TOKEN=

# Mode: "mt5" to talk to a running MetaTrader 5 terminal via the ZeroMQ EA,
#       "simulate" to generate fake data (useful for testing without MT5).
MODE=mt5

# ── ZeroMQ addresses exposed by the MQL5 EA (Bridge.mq5) ─────────────────────
# The EA PUBLISHes account/position/log data and REPlies to trade commands.
ZMQ_SUB_ADDR=tcp://127.0.0.1:5556
ZMQ_REQ_ADDR=tcp://127.0.0.1:5557

# How often (ms) to push a heartbeat to the cloud.
HEARTBEAT_MS=15000
