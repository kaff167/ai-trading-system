{
  "name": "mt5-local-bridge",
  "version": "1.0.0",
  "description": "Local bridge that connects MetaTrader 5 (via ZeroMQ) to the cloud AI Trading dashboard",
  "main": "bridge.js",
  "bin": {
    "mt5-bridge": "bridge.js"
  },
  "scripts": {
    "start": "node bridge.js",
    "simulate": "node bridge.js --simulate",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/mt5-bridge.exe"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "socket.io-client": "^4.7.5"
  },
  "optionalDependencies": {
    "zeromq": "^6.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": ["*.js"],
    "assets": []
  }
}
