# ─── Dashboard configuration ────────────────────────────────────────────────
# Port the combined Next.js + Socket.IO server listens on.
PORT=3000

# Secret used to sign dashboard login JWTs. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# Demo / login credentials for the simple built-in auth.
# (For a real deployment, replace the auth route with Supabase or your own DB.)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# Built-in simulator: when "true", any dashboard that subscribes to the
# DEMO_TOKEN below will receive realistic simulated bot data even if no
# local bridge is connected. This lets you demo / test the UI without MT5.
SIMULATE=true
DEMO_TOKEN=DEMO-1234

# Public URL of this dashboard (used in docs / share links). Optional.
NEXT_PUBLIC_APP_NAME=AI Trading Bot
